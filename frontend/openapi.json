  "info": {
    "description": "AI-powered document intelligence platform",
    "title": "DocuMind API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/": {
      "get": {
        "operationId": "root__get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Root"
      }
    },
    "/auth/login": {
      "post": {
        "description": "Login with email and password (JSON body: {\"email\", \"password\"}).\n\n- Verifies credentials\n- Returns a JWT access token\n\nThe client stores this token and sends it with every future request\nin the header: \"Authorization: Bearer <token>\"",
        "operationId": "login_auth_login_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserLogin"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Token"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Login",
        "tags": [
          "authentication"
        ]
      }
    },
    "/auth/me": {
      "get": {
        "description": "Get the currently logged-in user's information.\nRequires a valid JWT token.",
        "operationId": "get_current_user_info_auth_me_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "OAuth2PasswordBearer": []
          }
        ],
        "summary": "Get Current User Info",
        "tags": [
          "authentication"
        ]
      }
    },
    "/auth/signup": {
      "post": {
        "description": "Create a new user account.\n\n- Checks if email already exists\n- Hashes the password\n- Saves user to database\n- Returns user info (WITHOUT password)\n\nstatus_code=201 means \"Created\" \u2014 more accurate than 200 for creation\nresponse_model=UserResponse tells FastAPI to filter the output\nthrough UserResponse schema (so hashed_password never leaks out)",
        "operationId": "signup_auth_signup_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Signup",
        "tags": [
          "authentication"
        ]
      }
    },
    "/auth/token": {
      "post": {
        "description": "Login with the OAuth2 password form: form fields \"username\" and \"password\".\n\nSame as /auth/login, but in the format Swagger's Authorize button sends\n(the OAuth2 \"password\" flow names the field \"username\"). Put your email\nin the username field.",
        "operationId": "login_with_form_auth_token_post",
        "requestBody": {
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "$ref": "#/components/schemas/Body_login_with_form_auth_token_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Token"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Login With Form",
        "tags": [
          "authentication"
        ]
      }
    },
    "/documents/": {
      "get": {
        "description": "List all documents for the current user",
        "operationId": "list_documents_documents__get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DocumentListResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "OAuth2PasswordBearer": []
          }
        ],
        "summary": "List Documents",
        "tags": [
          "documents"
        ]
      }
    },
    "/documents/upload": {
      "post": {
        "description": "Upload a PDF document.\n\nThe file is saved immediately and processing happens in the background.\nThis means the API responds fast (doesn't make user wait for embeddings).\n\nBackgroundTasks is FastAPI's built-in background job system.",
        "operationId": "upload_document_documents_upload_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_upload_document_documents_upload_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DocumentResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "OAuth2PasswordBearer": []
          }
        ],
        "summary": "Upload Document",
        "tags": [
          "documents"
        ]
      }
    },
    "/documents/{document_id}": {
      "delete": {
        "description": "Delete a document, its chunks and its uploaded PDF file.",
        "operationId": "delete_document_documents__document_id__delete",
        "parameters": [
          {
            "in": "path",
            "name": "document_id",
            "required": true,
            "schema": {
              "title": "Document Id",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "OAuth2PasswordBearer": []
          }
        ],
        "summary": "Delete Document",
        "tags": [
          "documents"
        ]
      },
      "get": {
        "description": "Get a specific document by ID",
        "operationId": "get_document_documents__document_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "document_id",
            "required": true,
            "schema": {
              "title": "Document Id",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DocumentResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "OAuth2PasswordBearer": []
          }
        ],
        "summary": "Get Document",
        "tags": [
          "documents"
        ]
      }
    },
    "/documents/{document_id}/file": {
      "get": {
        "description": "The uploaded PDF of one of your documents, sent inline so a browser can\nshow it (the frontend opens it at a cited page).",
        "operationId": "get_document_file_documents__document_id__file_get",
        "parameters": [
          {
            "in": "path",
            "name": "document_id",
            "required": true,
            "schema": {
              "title": "Document Id",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "OAuth2PasswordBearer": []
          }
        ],
        "summary": "Get Document File",
        "tags": [
          "documents"
        ]
      }
    },
    "/documents/{document_id}/search": {
      "get": {
        "description": "Semantic search within a document.\n\n?q=your question here\n?top_k=5 (how many chunks to return)\n\nThis is the retrieval part of RAG; POST /query/ adds answer\ngeneration on top of it.",
        "operationId": "search_document_documents__document_id__search_get",
        "parameters": [
          {
            "in": "path",
            "name": "document_id",
            "required": true,
            "schema": {
              "title": "Document Id",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "q",
            "required": true,
            "schema": {
              "title": "Q",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "top_k",
            "required": false,
            "schema": {
              "default": 5,
              "title": "Top K",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "OAuth2PasswordBearer": []
          }
        ],
        "summary": "Search Document",
        "tags": [
          "documents"
        ]
      }
    },
    "/documents/{document_id}/status": {
      "get": {
        "description": "Check processing status of a document.\nPoll this endpoint after uploading to know when processing is done.\nWhen the status is \"failed\", error_message says why.",
        "operationId": "get_document_status_documents__document_id__status_get",
        "parameters": [
          {
            "in": "path",
            "name": "document_id",
            "required": true,
            "schema": {
              "title": "Document Id",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "OAuth2PasswordBearer": []
          }
        ],
        "summary": "Get Document Status",
        "tags": [
          "documents"
        ]
      }
    },
    "/health": {
      "get": {
        "operationId": "health_check_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health Check"
      }
    },
    "/query/": {
      "post": {
        "description": "Answer a question about one of your processed documents.\n\n1. Retrieves the max_results chunks most similar to the question (pgvector).\n2. Asks the configured provider (LLM_PROVIDER: gemini, anthropic, or none)\n   to answer from those chunks only, citing pages as [p.N]. With \"none\",\n   the answer is the document's most similar sentences, labelled as such.\n3. Returns \"Not found in the document.\" when the sources do not hold the answer.\n\ngrounded is true when the answer cites at least one page and every cited\npage is among the retrieved sources, or when the answer is \"Not found in\nthe document.\". It checks page numbers only, not whether the cited text\nsupports the answer.\n\nErrors: 404 if the document does not exist or is not yours, 400 if it is\nnot processed yet, 502 if the LLM provider fails.",
        "operationId": "query_document_query__post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/QueryRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueryResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "OAuth2PasswordBearer": []
          }
        ],
        "summary": "Query Document",
        "tags": [
          "query"
        ]
      }
    }
  }
}

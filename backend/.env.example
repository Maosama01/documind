# Copy this file to backend/.env and fill it in.
# backend/.env is gitignored. Never commit it.

# Required. Signs the JWT access tokens. The app refuses to start without it.
# Must be at least 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Optional. The default below matches the db service in docker-compose.yml.
DATABASE_URL=postgresql://documind_user:documind_pass@localhost:5432/documind

# Optional. Chunk size and overlap in tokens of the embedding model's tokenizer
# (defaults 240 and 40). The model reads at most 256 tokens per chunk, two of
# which it uses itself. The app refuses to start unless
# 0 <= CHUNK_OVERLAP_TOKENS < CHUNK_SIZE_TOKENS <= 254.
CHUNK_SIZE_TOKENS=240
CHUNK_OVERLAP_TOKENS=40

# Optional. Who writes answers for POST /query/: none (default), gemini or anthropic.
# none = extractive fallback: returns the document's most relevant sentences,
# no API key and no external call. The app refuses to start if the chosen
# provider's key is empty.
LLM_PROVIDER=none
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
ANTHROPIC_API_KEY=
# Most capable and most expensive; claude-haiku-5-5 costs less per query.
ANTHROPIC_MODEL=claude-opus-5-5
LLM_TIMEOUT_SECONDS=30

# Optional, default false. When true, unhandled errors return a traceback in the
# HTTP response. Only for local development.
DEBUG=false

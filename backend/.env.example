# Copy this file to backend/.env and fill it in.
# backend/.env is gitignored. Never commit it.

# Required. Signs the JWT access tokens. The app refuses to start without it.
# Must be at least 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Optional. The default below matches the db service in docker-compose.yml.
DATABASE_URL=postgresql://documind_user:documind_pass@localhost:5432/documind

# Optional. Chunk size and overlap in words (defaults 180 and 30). The embedding
# model reads at most 256 tokens per chunk (roughly 185 words of English prose on
# the one PDF measured) and silently ignores the rest. The app refuses to start unless
# 20 <= CHUNK_OVERLAP_WORDS < CHUNK_SIZE_WORDS.
CHUNK_SIZE_WORDS=180
CHUNK_OVERLAP_WORDS=30

# Optional, default false. When true, unhandled errors return a traceback in the
# HTTP response. Only for local development.
DEBUG=false
